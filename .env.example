# Copia questo file in .env.local e metti i valori veri (.env.local non va su GitHub).
# Su Vercel gli stessi tre valori vanno in Settings > Environment Variables.

# ID del Google Sheet: è la parte del link tra /d/ e /edit
GOOGLE_SHEET_ID=

# Dal file JSON dell'account di servizio: "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Dal file JSON dell'account di servizio: "private_key", tra virgolette, così com'è (con i \n)
GOOGLE_PRIVATE_KEY=""

# Parola d'ordine della pagina /controllo (quella che mostra le righe sbagliate del foglio).
# Se resta vuota la pagina non esiste.
CONTROLLO_PASSWORD=

# Ordini dal sito: indirizzo dello script di Nicholas (Distribuisci > Gestisci distribuzioni > App web, finisce con /exec)
# e parola d'ordine, uguale alla proprietà SITO_SEGRETO dello script. Se mancano, gli ordini vanno solo su WhatsApp.
ORDINI_URL=
ORDINI_SEGRETO=
